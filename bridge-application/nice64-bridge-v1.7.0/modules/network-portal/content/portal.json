{
  "portal": {
    "title": "NICE64 Network Portal",
    "version": "0.9.0",
    "timezone": "America/Phoenix"
  },
  "ollama": {
    "enabled": false,
    "url": "http://localhost:11434",
    "model": "llama3",
    "timeoutSeconds": 60,
    "maxResponseChars": 4000
  },
  "menu": [
    {
      "title": "Welcome",
      "resource": "bridge://welcome",
      "icon": "smile"
    },
    {
      "title": "Headlines",
      "resource": "bridge://rssr",
      "icon": "news"
    },
    {
      "title": "ITcorp Demo",
      "resource": "bridge://itcorp",
      "icon": "web"
    },
    {
      "title": "About",
      "resource": "bridge://about",
      "icon": "info"
    },
    {
      "title": "Diagnostics",
      "resource": "bridge://diagnostics",
      "icon": "diag"
    },
    {
      "title": "News",
      "resource": "bridge://news",
      "icon": "news"
    },
    {
      "title": "Ask NICE64",
      "resource": "bridge://ollama",
      "icon": "chat"
    },
    {
      "title": "Current Time",
      "resource": "bridge://time",
      "icon": "clock"
    }
  ],
  "resources": {
    "bridge://welcome": {
      "type": "file",
      "path": "content/welcome.txt"
    },
    "bridge://about": {
      "type": "file",
      "path": "content/about.txt"
    },
    "bridge://diagnostics": {
      "type": "file",
      "path": "content/diagnostics.txt"
    },
    "bridge://projects": {
      "type": "file",
      "path": "content/projects.txt"
    },
    "bridge://ollama": {
      "type": "dynamic",
      "provider": "ollama"
    },
    "bridge://aires": {
      "type": "dynamic",
      "provider": "ollama-result"
    },
    "bridge://news": {
      "type": "file",
      "path": "content/news.txt"
    },
    "bridge://time": {
      "type": "dynamic",
      "provider": "time"
    },
    "bridge://now": {
      "type": "dynamic",
      "provider": "now"
    },
    "bridge://itcorp": {
      "type": "webpage",
      "url": "https://itcorp.com/"
    },
    "bridge://rssr": {
      "type": "rss",
      "title": "Retro Gaming",
      "url": "https://www.retrorgb.com/feed",
      "maxItems": 8,
      "cacheSeconds": 300
    },
    "bridge://rssn": {
      "type": "rss",
      "title": "General News",
      "url": "https://feeds.bbci.co.uk/news/rss.xml",
      "maxItems": 8,
      "cacheSeconds": 300
    }
  }
}
